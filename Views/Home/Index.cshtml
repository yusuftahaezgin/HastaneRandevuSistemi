@model List<HastaneRandevuSistemi.Models.Poliklinik>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="intro-panel">
    <div class="intro-text">
        <span class="page-label">HASTANE RANDEVU SİSTEMİ</span>

        <h1>
            Sağlık hizmetlerine<br />
            kolayca ulaşın.
        </h1>

        <p>
            Hastanelerimizdeki poliklinikleri inceleyin,
            ihtiyacınıza uygun hastane ve doktoru seçin.
        </p>

        <a href="#poliklinikler" class="btn btn-primary">
            Poliklinikleri incele
        </a>
    </div>

    <div class="welcome-card">
        <div class="welcome-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="30"
                 height="30"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.6"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M3 21h18" />
                <path d="M5 21V7l8-4v18" />
                <path d="M19 21V11l-6-4" />
                <path d="M9 9v.01M9 12v.01M9 15v.01" />
                <path d="M16 14v.01M16 17v.01" />
            </svg>
        </div>

        <span class="welcome-label">HOŞ GELDİNİZ</span>

        <h2>Sağlığınız bizim için önemli.</h2>

        <p>
            Kurum, hastane ve poliklinik seçerek doktorları
            inceleyebilirsiniz. Randevu işlemlerinize
            hesabınız üzerinden ulaşabilirsiniz.
        </p>

        <div class="welcome-footer">
            <span class="welcome-footer-line"></span>
            <span>Sağlıklı günler dileriz.</span>
        </div>
    </div>
</section>

<section id="poliklinikler" class="departments-section">
    <div class="section-title">
        <div>
            <span class="page-label">POLİKLİNİKLER</span>
            <h2>Polikliniklerimiz</h2>
        </div>

        <span class="section-description">
            Hastane bilgisine göre polikliniğinizi seçin.
        </span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="status">
            Şu anda görüntülenebilecek aktif poliklinik bulunmuyor.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var poliklinik in Model)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="department-card d-flex flex-column">
                        <span class="department-code">
                            @poliklinik.Id.ToString("D2")
                        </span>

                        <h3>@poliklinik.Ad</h3>

                        <div class="mb-3">
                            <div class="small text-muted mb-1">
                                @poliklinik.Sube?.Kurum?.Ad
                            </div>

                            <div class="fw-semibold">
                                @poliklinik.Sube?.Ad
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(poliklinik.Aciklama))
                        {
                            <p>@poliklinik.Aciklama</p>
                        }

                        <a asp-controller="Randevu"
                           asp-action="Olustur"
                           asp-route-kurumId="@poliklinik.Sube?.KurumId"
                           asp-route-subeId="@poliklinik.SubeId"
                           asp-route-poliklinikId="@poliklinik.Id"
                           class="mt-auto pt-2">
                            Randevu Al →
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</section>