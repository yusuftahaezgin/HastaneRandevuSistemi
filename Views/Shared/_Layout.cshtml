@{
    var girisYapildi = User.Identity?.IsAuthenticated == true;
    var yoneticiMi = girisYapildi && User.IsInRole("Yonetici");

    var calisanMi = girisYapildi
        && !yoneticiMi
        && (User.IsInRole("Doktor")
            || User.IsInRole("SaglikPersoneli"));

    var hastaMi = girisYapildi
        && !yoneticiMi
        && !calisanMi
        && User.IsInRole("Hasta");

    var anaController = calisanMi ? "Calisan" : "Home";
    var anaAction = calisanMi ? "Randevular" : "Index";

    var yonetimBaglantilari = new[]
    {
        ("Index", "Yönetici Paneli"),
        ("UcretVeHizmetler", "Ücret ve Hizmet Yönetimi"),
        ("Randevular", "Randevu Onayları"),
        ("HastaneSaatleri", "Hastane Çalışma Saatleri"),
        ("CalismaSaatleri", "Doktor Çalışma Saatleri"),
        ("Kurumlar", "Kurum Yönetimi"),
        ("Subeler", "Şube Yönetimi"),
        ("Poliklinikler", "Poliklinik Yönetimi"),
        ("Doktorlar", "Doktor Yönetimi"),
        ("SaglikPersonelleri", "Sağlık Personeli Yönetimi")
    };
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Hastane Randevu</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/HastaneRandevuSistemi.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand app-brand"
                   asp-controller="@anaController"
                   asp-action="@anaAction">

                    <span class="brand-mark" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 32 32"
                             width="24"
                             height="24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M16 3v7M12.5 6.5h7" />
                            <path d="M7 12h18v16H7z" />
                            <path d="M11 16h2M19 16h2" />
                            <path d="M11 20h2M19 20h2" />
                            <path d="M14 28v-5h4v5" />
                        </svg>
                    </span>

                    <span>
                        Hastane <span class="brand-highlight">Randevu</span>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Menüyü aç veya kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (calisanMi)
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link"
                                   asp-controller="Calisan"
                                   asp-action="Randevular">
                                    Randevularım
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Ana Sayfa
                                </a>
                            </li>

                            @if (yoneticiMi)
                            {
                                <li class="nav-item dropdown">
                                    <button class="nav-link app-nav-link dropdown-toggle border-0 bg-transparent"
                                            type="button"
                                            id="yonetimMenu"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        Yönetim Panelleri
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end"
                                        aria-labelledby="yonetimMenu">
                                        @foreach (var baglanti in yonetimBaglantilari)
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-controller="Admin"
                                                   asp-action="@baglanti.Item1">
                                                    @baglanti.Item2
                                                </a>
                                            </li>

                                            @if (baglanti.Item1 == "Index")
                                            {
                                                <li>
                                                    <hr class="dropdown-divider" />
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-nav-link"
                                       asp-controller="Home"
                                       asp-action="Index"
                                       asp-fragment="poliklinikler">
                                        Poliklinikler
                                    </a>
                                </li>

                                @if (hastaMi)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link app-nav-link"
                                           asp-controller="Randevu"
                                           asp-action="Liste">
                                            Randevularım
                                        </a>
                                    </li>
                                }
                            }
                        }

                        @if (girisYapildi)
                        {
                            <li class="nav-item">
                                <span class="nav-link app-nav-link">
                                    @User.Identity?.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Cikis"
                                      method="post"
                                      asp-antiforgery="true">
                                    <button type="submit"
                                            class="nav-link app-nav-link border-0 bg-transparent">
                                        Çıkış Yap
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link"
                                   asp-controller="Account"
                                   asp-action="Giris">
                                    Giriş Yap
                                </a>
                            </li>
                        }

                        @if (hastaMi || !girisYapildi)
                        {
                            <li class="nav-item">
                                <a class="nav-link app-login-link"
                                   asp-controller="Randevu"
                                   asp-action="Olustur">
                                    Randevu Al
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container py-3">
            © @DateTime.Now.Year - Hastane Randevu Sistemi
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>