@model List<HastaneRandevuSistemi.Models.Kurum>

@{
    ViewData["Title"] = "Kurum Yönetimi";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2>Kurum Yönetimi</h2>
            <p class="text-muted mb-0">
                Kurumların bilgilerini ve aktiflik durumunu yönetin.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Yönetici Paneline Dön
            </a>

            <a asp-controller="Admin"
               asp-action="KurumEkle"
               class="btn btn-primary">
                + Yeni Kurum Ekle
            </a>
        </div>
    </div>

    @if (TempData["Basari"] is string mesaj)
    {
        <div class="alert alert-success" role="alert">
            @mesaj
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Henüz kurum kaydı bulunmuyor.
        </div>
    }
    else
    {
        <div class="card p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kurum Adı</th>
                            <th>Açıklama</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kurum in Model)
                        {
                            <tr>
                                <td>@kurum.Id</td>

                                <td class="fw-bold">@kurum.Ad</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(kurum.Aciklama)
                                        ? "—"
                                        : kurum.Aciklama)
                                </td>

                                <td>
                                    @if (kurum.AktifMi)
                                    {
                                        <span class="badge bg-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Admin"
                                           asp-action="KurumDuzenle"
                                           asp-route-id="@kurum.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Düzenle
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="KurumDurumDegistir"
                                              asp-route-id="@kurum.Id"
                                              method="post"
                                              asp-antiforgery="true">
                                            <button type="submit"
                                                    class="btn btn-sm @(kurum.AktifMi ? "btn-outline-danger" : "btn-outline-success")">
                                                @(kurum.AktifMi ? "Pasif Yap" : "Aktif Yap")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>