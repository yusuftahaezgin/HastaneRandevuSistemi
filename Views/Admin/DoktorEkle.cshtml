@model HastaneRandevuSistemi.Models.DoktorEkleViewModel

@{
    ViewData["Title"] = "Doktor Ekle";
}

<div class="container py-5">
    <div class="mb-4">
        <h2>Doktor Ekle</h2>
        <p class="text-muted">
            Yeni doktor ve sisteme giriş hesabı oluşturun.
        </p>
    </div>

    <div class="card p-4" style="max-width: 700px;">
        <form asp-controller="Admin"
              asp-action="DoktorEkle"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Unvan" class="form-label">
                    Unvan
                </label>

                <select asp-for="Unvan" class="form-select">
                    <option value="Dr.">Dr.</option>
                    <option value="Uzm. Dr.">Uzm. Dr.</option>
                    <option value="Doç. Dr.">Doç. Dr.</option>
                    <option value="Prof. Dr.">Prof. Dr.</option>
                </select>

                <span asp-validation-for="Unvan"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ad" class="form-label">
                    Ad
                </label>

                <input asp-for="Ad" class="form-control" />

                <span asp-validation-for="Ad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Soyad" class="form-label">
                    Soyad
                </label>

                <input asp-for="Soyad" class="form-control" />

                <span asp-validation-for="Soyad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PoliklinikId" class="form-label">
                    Poliklinik
                </label>

                <select asp-for="PoliklinikId"
                        asp-items="ViewBag.Poliklinikler"
                        class="form-select">
                    <option value="">Poliklinik seçin</option>
                </select>

                <span asp-validation-for="PoliklinikId"
                      class="text-danger"></span>
            </div>

            <hr class="my-4" />

            <h5>Doktor Giriş Bilgileri</h5>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    E-posta Adresi
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Parola" class="form-label">
                    İlk Şifre
                </label>

                <input asp-for="Parola"
                       class="form-control" />

                <span asp-validation-for="Parola"
                      class="text-danger"></span>

                <small class="text-muted">
                    En az 8 karakter; büyük harf, küçük harf,
                    rakam ve özel karakter içermelidir.
                </small>
            </div>

            <div class="mb-4">
                <label asp-for="ParolaTekrar" class="form-label">
                    İlk Şifre Tekrar
                </label>

                <input asp-for="ParolaTekrar"
                       class="form-control" />

                <span asp-validation-for="ParolaTekrar"
                      class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Doktoru Kaydet
                </button>

                <a asp-controller="Admin"
                   asp-action="Doktorlar"
                   class="btn btn-outline-secondary">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}