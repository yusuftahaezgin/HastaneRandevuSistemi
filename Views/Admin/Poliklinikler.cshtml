@model IEnumerable<HastaneRandevuSistemi.Models.Poliklinik>

@{
    ViewData["Title"] = "Poliklinik Yönetimi";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <h2>Poliklinik Yönetimi</h2>
            <p class="text-muted mb-0">
                Hastanelere bağlı poliklinikleri buradan yönetin.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Yönetici Paneline Dön
            </a>

            <a asp-controller="Admin"
               asp-action="PoliklinikEkle"
               class="btn btn-primary">
                + Yeni Poliklinik Ekle
            </a>
        </div>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success">
            @TempData["Basari"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Henüz poliklinik kaydı bulunmuyor.
        </div>
    }
    else
    {
        <div class="card p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kurum / Hastane</th>
                            <th>Poliklinik Adı</th>
                            <th>Açıklama</th>
                            <th>Poliklinik Durumu</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var poliklinik in Model)
                        {
                            <tr>
                                <td>@poliklinik.Id</td>

                                <td>
                                    @if (poliklinik.Sube is null)
                                    {
                                        <span class="text-danger">
                                            Hastane atanmamış
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="small text-muted mb-1">
                                            @poliklinik.Sube.Kurum.Ad
                                        </div>

                                        <div>
                                            @poliklinik.Sube.Ad
                                        </div>

                                        @if (!poliklinik.Sube.Kurum.AktifMi)
                                        {
                                            <span class="badge bg-secondary mt-1">
                                                Kurum pasif
                                            </span>
                                        }

                                        @if (!poliklinik.Sube.AktifMi)
                                        {
                                            <span class="badge bg-secondary mt-1">
                                                Hastane pasif
                                            </span>
                                        }
                                    }
                                </td>

                                <td>
                                    <strong>@poliklinik.Ad</strong>
                                </td>

                                <td>@poliklinik.Aciklama</td>

                                <td>
                                    @if (poliklinik.AktifMi)
                                    {
                                        <span class="badge bg-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Admin"
                                           asp-action="PoliklinikDuzenle"
                                           asp-route-id="@poliklinik.Id"
                                           class="btn btn-sm btn-outline-primary text-nowrap">
                                            Düzenle
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="DurumDegistir"
                                              asp-route-id="@poliklinik.Id"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            @if (poliklinik.AktifMi)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger text-nowrap">
                                                    Pasif Yap
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success text-nowrap">
                                                    Aktif Yap
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>