
@model IEnumerable<HastaneRandevuSistemi.Models.Poliklinik>

@{
    ViewData["Title"] = "Poliklinik Yönetimi";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Poliklinik Yönetimi</h2>
            <p class="text-muted mb-0">
                Hastanedeki poliklinikleri buradan yönetebilirsiniz.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Index"
               class="btn btn-outline-secondary">
                Yönetici Paneline Dön
            </a>

            <a asp-controller="Admin" asp-action="PoliklinikEkle"
               class="btn btn-primary">
                + Yeni Poliklinik Ekle
            </a>
        </div>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success">
            @TempData["Basari"]
        </div>
    }

    <div class="card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Poliklinik Adı</th>
                        <th>Açıklama</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var poliklinik in Model)
                    {
                        <tr>
                            <td>@poliklinik.Id</td>

                            <td>
                                <strong>@poliklinik.Ad</strong>
                            </td>

                            <td>@poliklinik.Aciklama</td>

                            <td>
                                @if (poliklinik.AktifMi)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">

                                    <a asp-controller="Admin"
                                       asp-action="PoliklinikDuzenle"
                                       asp-route-id="@poliklinik.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Düzenle
                                    </a>

                                    <form asp-controller="Admin"
                                          asp-action="DurumDegistir"
                                          asp-route-id="@poliklinik.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        @if (poliklinik.AktifMi)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Pasif Yap
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Aktif Yap
                                            </button>
                                        }
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
