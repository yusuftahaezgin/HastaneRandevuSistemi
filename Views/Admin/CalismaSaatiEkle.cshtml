@model DoktorCalismaSaatiFormViewModel
@{
    ViewData["Title"] = "Çalışma Saati Ekle";
    var doktorVar = ViewBag.SecilebilirDoktorVar == true;
}

<div class="container py-5">
    <h2>Çalışma Saati Ekle</h2>
    <p class="text-muted mb-4">
        Doktorun haftalık çalışma programını oluşturun. Öğle arası için aynı güne iki ayrı kayıt ekleyebilirsiniz.
    </p>

    <div class="row">
        <div class="col-lg-8">
            @if (!doktorVar)
            {
                <div class="alert alert-info">
                    Çalışma saati eklenebilecek aktif doktor bulunmuyor.
                    Doktorun, polikliniğinin, hastanesinin ve kurumunun aktif olması gerekir.
                </div>
            }

            <form asp-action="CalismaSaatiEkle" method="post" asp-antiforgery="true"
                  class="card p-4" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="DoktorId" class="form-label"></label>
                    <select asp-for="DoktorId" asp-items="ViewBag.Doktorlar" class="form-select">
                        <option value="">Doktor seçin</option>
                    </select>
                    <span asp-validation-for="DoktorId" class="text-danger"></span>
                </div>

                <partial name="_CalismaSaatiAlanlari" model="Model" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@(!doktorVar)">Kaydet</button>
                    <a asp-action="CalismaSaatleri" class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
