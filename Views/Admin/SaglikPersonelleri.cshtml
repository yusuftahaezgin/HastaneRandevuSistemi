@model IEnumerable<HastaneRandevuSistemi.Models.SaglikPersoneli>

@{
    ViewData["Title"] = "Sağlık Personeli Yönetimi";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2>Sağlık Personeli Yönetimi</h2>
            <p class="text-muted mb-0">
                Sağlık personelinin bilgilerini ve aktiflik durumunu yönetin.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Yönetici Paneline Dön
            </a>

            <a asp-controller="Admin"
               asp-action="SaglikPersoneliEkle"
               class="btn btn-primary">
                + Yeni Personel Ekle
            </a>
        </div>
    </div>

    @if (TempData["Basari"] is string mesaj)
    {
        <div class="alert alert-success" role="alert">
            @mesaj
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Henüz sağlık personeli kaydı bulunmuyor.
        </div>
    }
    else
    {
        <div class="card p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Personel</th>
                            <th>Poliklinik</th>
                            <th>Giriş E-postası</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var personel in Model)
                        {
                            <tr>
                                <td>@personel.Id</td>

                                <td class="fw-semibold">
                                    @personel.GorunenAdGetir()
                                </td>

                                <td>@personel.Poliklinik.Ad</td>

                                <td>
                                    @(personel.Kullanici?.Email ?? "Giriş hesabı yok")
                                </td>

                                <td>
                                    @if (personel.AktifMi)
                                    {
                                        <span class="badge bg-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Admin"
                                           asp-action="SaglikPersoneliDuzenle"
                                           asp-route-id="@personel.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Düzenle
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="SaglikPersoneliDurumDegistir"
                                              asp-route-id="@personel.Id"
                                              method="post"
                                              asp-antiforgery="true">
                                            <button type="submit"
                                                    class="btn btn-sm @(personel.AktifMi ? "btn-outline-danger" : "btn-outline-success")">
                                                @(personel.AktifMi ? "Pasif Yap" : "Aktif Yap")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>