@model List<HastaneRandevuSistemi.Models.Sube>

@{
    ViewData["Title"] = "Şube Yönetimi";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2>Şube Yönetimi</h2>
            <p class="text-muted mb-0">
                Kurumlara bağlı hastaneleri ve şubeleri yönetin.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Yönetici Paneline Dön
            </a>

            <a asp-controller="Admin"
               asp-action="SubeEkle"
               class="btn btn-primary">
                + Yeni Şube Ekle
            </a>
        </div>
    </div>

    @if (TempData["Basari"] is string mesaj)
    {
        <div class="alert alert-success" role="alert">
            @mesaj
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            Henüz şube kaydı bulunmuyor.
        </div>
    }
    else
    {
        <div class="card p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kurum</th>
                            <th>Şube / Hastane</th>
                            <th>Adres</th>
                            <th>Telefon</th>
                            <th>Şube Durumu</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var sube in Model)
                        {
                            <tr>
                                <td>@sube.Id</td>

                                <td>
                                    @sube.Kurum.Ad

                                    @if (!sube.Kurum.AktifMi)
                                    {
                                        <span class="badge bg-secondary d-inline-block">
                                            Kurum pasif
                                        </span>
                                    }
                                </td>

                                <td class="fw-bold">@sube.Ad</td>

                                <td>@sube.Adres</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(sube.Telefon)
                                        ? "—"
                                        : sube.Telefon)
                                </td>

                                <td>
                                    @if (sube.AktifMi)
                                    {
                                        <span class="badge bg-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Admin"
                                           asp-action="SubeDuzenle"
                                           asp-route-id="@sube.Id"
                                           class="btn btn-sm btn-outline-primary text-nowrap">
                                            Düzenle
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="SubeDurumDegistir"
                                              asp-route-id="@sube.Id"
                                              method="post"
                                              asp-antiforgery="true">
                                            <button type="submit"
                                                    class="btn btn-sm text-nowrap @(sube.AktifMi ? "btn-outline-danger" : "btn-outline-success")">
                                                @(sube.AktifMi ? "Pasif Yap" : "Aktif Yap")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>