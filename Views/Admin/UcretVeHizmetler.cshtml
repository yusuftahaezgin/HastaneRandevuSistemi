@model HastaneRandevuSistemi.Models.TarifeYonetimModel
@using System.Globalization

@{
    ViewData["Title"] = "Ücret ve Hizmet Yönetimi";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
}

<div class="py-5">
    <h2>Ücret ve Hizmet Yönetimi</h2>

    <p class="text-muted">
        Doktor ve sağlık personeli hizmetlerini buradan yönetin.
        Hizmet adı ve ücret değişiklikleri yeni randevularda geçerlidir.
        Kaydedilmiş randevuların işlem adları ve ücretleri korunur.
    </p>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-controller="Admin"
           asp-action="Randevular"
           class="btn btn-primary">
            Randevu Onayları
        </a>

        <a asp-controller="Admin"
           asp-action="CalismaSaatleri"
           class="btn btn-outline-primary">
            Doktor Çalışma Saatleri
        </a>

        <a asp-controller="Admin"
           asp-action="HastaneSaatleri"
           class="btn btn-outline-primary">
            Hastane Çalışma Saatleri
        </a>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Yönetici Paneli
        </a>
    </div>

    @if (TempData["Hata"] is string hata)
    {
        <div class="alert alert-danger">@hata</div>
    }

    @if (TempData["Basari"] is string basari)
    {
        <div class="alert alert-success">@basari</div>
    }

    <section id="doktor-hizmetleri">
        <h3 class="h4 mt-4">Doktor Hizmetleri ve Ücretleri</h3>

        <p class="text-muted">
            Her doktorun hizmet adını ve ücretini düzenleyebilirsiniz.
            Randevu süresi doktorun çalışma programından alınır.
        </p>

        @if (Model.Doktorlar.Count == 0)
        {
            <div class="alert alert-info">
                Henüz doktor eklenmemiş.
            </div>
        }

        @foreach (var d in Model.Doktorlar)
        {
            <form asp-controller="Admin"
                  asp-action="DoktorHizmetiKaydet"
                  method="post"
                  class="card p-3 mb-3">

                <input type="hidden" name="id" value="@d.Id" />

                <div class="mb-3">
                    <strong>@d.GorunenAdGetir()</strong>

                    <div class="text-muted">
                        @d.Poliklinik.Sube?.Ad / @d.Poliklinik.Ad
                    </div>

                    @if (!d.AktifMi)
                    {
                        <span class="badge bg-secondary mt-1">
                            Doktor pasif
                        </span>
                    }
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="doktor-hizmet-@d.Id"
                               class="form-label">
                            Hizmet adı
                        </label>

                        <input id="doktor-hizmet-@d.Id"
                               name="hizmetAdi"
                               value="@d.HizmetAdi"
                               maxlength="150"
                               placeholder="Örneğin nöroloji muayenesi"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label for="doktor-ucret-@d.Id"
                               class="form-label">
                            Hizmet ücreti (TL)
                        </label>

                        <input id="doktor-ucret-@d.Id"
                               name="ucret"
                               value="@(d.RandevuUcreti?.ToString(CultureInfo.InvariantCulture))"
                               placeholder="Örneğin 1000 veya 1000,50"
                               inputmode="decimal"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-2">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Kaydet
                        </button>
                    </div>
                </div>
            </form>
        }
    </section>

    <section id="personel-hizmetleri">
        <h3 class="h4 mt-5">Sağlık Personeline Hizmet Ekle</h3>

        <form asp-controller="Admin"
              asp-action="PersonelHizmetiKaydet"
              method="post"
              class="card p-3 mb-4">

            <input type="hidden" name="id" value="0" />

            <label for="yeni-hizmet-personel" class="form-label">
                Sağlık personeli
            </label>

            <select id="yeni-hizmet-personel"
                    name="personelId"
                    class="form-select mb-3"
                    required>
                <option value="">Personel seçin</option>

                @foreach (var p in Model.Personeller)
                {
                    <option value="@p.Id">
                        @p.Poliklinik.Sube?.Ad /
                        @p.Poliklinik.Ad /
                        @p.GorunenAdGetir()
                    </option>
                }
            </select>

            <div class="row g-3">
                <div class="col-md-5">
                    <label for="yeni-hizmet-ad" class="form-label">
                        Hizmet adı
                    </label>

                    <input id="yeni-hizmet-ad"
                           name="ad"
                           class="form-control"
                           maxlength="150"
                           placeholder="Kan alma, röntgen..."
                           required />
                </div>

                <div class="col-md-3">
                    <label for="yeni-hizmet-sure" class="form-label">
                        Süre (dakika)
                    </label>

                    <input id="yeni-hizmet-sure"
                           name="sure"
                           type="number"
                           value="20"
                           min="5"
                           max="120"
                           class="form-control"
                           required />
                </div>

                <div class="col-md-4">
                    <label for="yeni-hizmet-ucret" class="form-label">
                        Ücret (TL)
                    </label>

                    <input id="yeni-hizmet-ucret"
                           name="ucret"
                           inputmode="decimal"
                           placeholder="Örneğin 750"
                           class="form-control"
                           required />
                </div>
            </div>

            <div class="form-check my-3">
                <input id="yeni-hizmet-aktif"
                       type="checkbox"
                       name="aktif"
                       value="true"
                       checked
                       class="form-check-input" />

                <label for="yeni-hizmet-aktif"
                       class="form-check-label">
                    Aktif
                </label>
            </div>

            <input type="hidden" name="aktif" value="false" />

            <div>
                <button type="submit" class="btn btn-primary">
                    Hizmet Ekle
                </button>
            </div>
        </form>

        <h3 class="h4">Mevcut Sağlık Personeli Hizmetleri</h3>

        @if (Model.Hizmetler.Count == 0)
        {
            <p class="text-muted">Henüz hizmet tanımlanmadı.</p>
        }

        @foreach (var h in Model.Hizmetler)
        {
            <form asp-controller="Admin"
                  asp-action="PersonelHizmetiKaydet"
                  method="post"
                  class="card p-3 mb-3">

                <input type="hidden" name="id" value="@h.Id" />

                <input type="hidden"
                       name="personelId"
                       value="@h.PersonelId" />

                <p>
                    <strong>@h.Personel.GorunenAdGetir()</strong>
                    <br />
                    <span class="text-muted">
                        @h.Personel.Poliklinik.Sube?.Ad /
                        @h.Personel.Poliklinik.Ad
                    </span>
                </p>

                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="personel-hizmet-ad-@h.Id"
                               class="form-label">
                            Hizmet adı
                        </label>

                        <input id="personel-hizmet-ad-@h.Id"
                               name="ad"
                               value="@h.Ad"
                               maxlength="150"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-2">
                        <label for="personel-hizmet-sure-@h.Id"
                               class="form-label">
                            Süre (dakika)
                        </label>

                        <input id="personel-hizmet-sure-@h.Id"
                               name="sure"
                               type="number"
                               value="@h.SureDakika"
                               min="5"
                               max="120"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-3">
                        <label for="personel-hizmet-ucret-@h.Id"
                               class="form-label">
                            Ücret (TL)
                        </label>

                        <input id="personel-hizmet-ucret-@h.Id"
                               name="ucret"
                               value="@h.Ucret.ToString(CultureInfo.InvariantCulture)"
                               inputmode="decimal"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-3 d-flex align-items-center gap-3">
                        <div class="form-check">
                            <input id="personel-hizmet-aktif-@h.Id"
                                   type="checkbox"
                                   name="aktif"
                                   value="true"
                                   checked="@h.AktifMi"
                                   class="form-check-input" />

                            <label for="personel-hizmet-aktif-@h.Id"
                                   class="form-check-label">
                                Aktif
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Güncelle
                        </button>
                    </div>
                </div>

                <input type="hidden" name="aktif" value="false" />
            </form>
        }
    </section>

    <section id="personel-saatleri">
        <h3 class="h4 mt-5">Sağlık Personeli Çalışma Saatleri</h3>

        <p class="text-muted">
            Hizmet süresine göre bu aralıklardan randevu saatleri üretilir.
            Öğle arası için iki ayrı aralık ekleyebilirsiniz.
            Hastanenin çalışma saatleri de randevu seçiminde dikkate alınır.
        </p>

        <form asp-controller="Admin"
              asp-action="PersonelCalismaSaatiEkle"
              method="post"
              class="card p-3 mb-3">

            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="saat-personel" class="form-label">
                        Personel
                    </label>

                    <select id="saat-personel"
                            name="personelId"
                            class="form-select"
                            required>
                        <option value="">Personel seçin</option>

                        @foreach (var p in Model.Personeller)
                        {
                            <option value="@p.Id">
                                @p.Poliklinik.Sube?.Ad /
                                @p.GorunenAdGetir()
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="saat-gun" class="form-label">
                        Gün
                    </label>

                    <select id="saat-gun"
                            name="gun"
                            class="form-select">
                        @foreach (var g in new[] { 1, 2, 3, 4, 5, 6, 0 })
                        {
                            <option value="@g">
                                @tr.DateTimeFormat.GetDayName((DayOfWeek)g)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="saat-baslangic" class="form-label">
                        Başlangıç
                    </label>

                    <input id="saat-baslangic"
                           name="baslangic"
                           type="time"
                           step="60"
                           required
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label for="saat-bitis" class="form-label">
                        Bitiş
                    </label>

                    <input id="saat-bitis"
                           name="bitis"
                           type="time"
                           step="60"
                           required
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Ekle
                    </button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Personel</th>
                        <th>Gün</th>
                        <th>Saat Aralığı</th>
                        <th>İşlem</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Saatler.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-muted">
                                Henüz personel çalışma saati tanımlanmadı.
                            </td>
                        </tr>
                    }

                    @foreach (var s in Model.Saatler)
                    {
                        <tr>
                            <td>@s.Personel.GorunenAdGetir()</td>

                            <td>
                                @tr.DateTimeFormat.GetDayName(s.Gun)
                            </td>

                            <td>
                                @s.Baslangic.ToString("HH:mm")
                                –
                                @s.Bitis.ToString("HH:mm")
                            </td>

                            <td>
                                <form asp-controller="Admin"
                                      asp-action="PersonelCalismaSaatiSil"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@s.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        Kaldır
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>