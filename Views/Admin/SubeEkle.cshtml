@model HastaneRandevuSistemi.Models.SubeFormViewModel

@{
    ViewData["Title"] = "Şube Ekle";
    bool aktifKurumVar = ViewBag.AktifKurumVar == true;
}

<div class="container py-5">
    <div class="mb-4">
        <h2>Şube Ekle</h2>
        <p class="text-muted">
            Bir kurum seçerek o kuruma bağlı hastane veya şube oluşturun.
        </p>
    </div>

    @if (!aktifKurumVar)
    {
        <div class="alert alert-warning" role="alert">
            Şube ekleyebilmek için en az bir aktif kurum bulunmalıdır.

            <a asp-controller="Admin"
               asp-action="Kurumlar"
               class="alert-link">
                Kurum yönetimine git
            </a>
        </div>
    }

    <div class="row">
        <div class="col-lg-7">
            <div class="card p-4">
                <form asp-controller="Admin"
                      asp-action="SubeEkle"
                      method="post"
                      asp-antiforgery="true">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="KurumId" class="form-label"></label>

                        <select asp-for="KurumId"
                                asp-items="ViewBag.Kurumlar"
                                class="form-select">
                            <option value="0">Kurum seçin</option>
                        </select>

                        <span asp-validation-for="KurumId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ad" class="form-label"></label>

                        <input asp-for="Ad"
                               class="form-control"
                               maxlength="150"
                               placeholder="Örneğin: Sakarya Medar Hastanesi" />

                        <span asp-validation-for="Ad"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Adres" class="form-label"></label>

                        <textarea asp-for="Adres"
                                  class="form-control"
                                  rows="3"
                                  maxlength="400"></textarea>

                        <span asp-validation-for="Adres"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefon" class="form-label"></label>

                        <input asp-for="Telefon"
                               type="tel"
                               class="form-control"
                               maxlength="30" />

                        <span asp-validation-for="Telefon"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="AktifMi"
                               class="form-check-input" />

                        <label asp-for="AktifMi"
                               class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2">
                        @if (aktifKurumVar)
                        {
                            <button type="submit" class="btn btn-primary">
                                Kaydet
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled>
                                Kaydet
                            </button>
                        }

                        <a asp-controller="Admin"
                           asp-action="Subeler"
                           class="btn btn-outline-secondary">
                            İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}