@model HastaneRandevuSistemi.Models.PoliklinikFormViewModel

@{
    ViewData["Title"] = "Poliklinik Düzenle";

    bool secilebilirSubeVar =
        ViewBag.SecilebilirSubeVar == true;
}

<div class="container py-5">
    <div class="mb-4">
        <h2>Poliklinik Düzenle</h2>
        <p class="text-muted">
            Poliklinik bilgilerini ve bağlı olduğu hastaneyi güncelleyin.
        </p>
    </div>

    @if (!secilebilirSubeVar)
    {
        <div class="alert alert-warning">
            Seçilebilecek hastane bulunmuyor.

            <a asp-controller="Admin"
               asp-action="Subeler"
               class="alert-link">
                Şube Yönetimine Git
            </a>
        </div>
    }

    <div class="card p-4" style="max-width: 750px;">
        <form asp-controller="Admin"
              asp-action="PoliklinikDuzenle"
              asp-route-id="@Model.Id"
              method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="SubeId"
                       class="form-label"></label>

                <select asp-for="SubeId"
                        asp-items="ViewBag.Subeler"
                        class="form-select">
                    <option value="0">Hastane seçin</option>
                </select>

                <span asp-validation-for="SubeId"
                      class="text-danger"></span>

                <div class="form-text">
                    Hastaneyi değiştirirseniz bu polikliniğe bağlı
                    doktor ve sağlık personeli de yeni hastaneye
                    bağlı hale gelir.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Ad"
                       class="form-label"></label>

                <input asp-for="Ad"
                       class="form-control" />

                <span asp-validation-for="Ad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Aciklama"
                       class="form-label"></label>

                <textarea asp-for="Aciklama"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Aciklama"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="AktifMi"
                       class="form-check-input" />

                <label asp-for="AktifMi"
                       class="form-check-label"></label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit"
                        class="btn btn-primary"
                        disabled="@(!secilebilirSubeVar)">
                    Değişiklikleri Kaydet
                </button>

                <a asp-controller="Admin"
                   asp-action="Poliklinikler"
                   class="btn btn-outline-secondary">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}