@model HastaneRandevuSistemi.Models.DoktorDuzenleViewModel

@{
    ViewData["Title"] = "Doktor Düzenle";
}

<div class="container py-5">
    <div class="mb-4">
        <h2>Doktor Düzenle</h2>
        <p class="text-muted">
            Doktorun bilgilerini güncelleyebilirsiniz.
        </p>
    </div>

    <div class="card p-4" style="max-width: 700px;">
        <form asp-controller="Admin"
              asp-action="DoktorDuzenle"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Unvan" class="form-label">
                    Unvan
                </label>

                <select asp-for="Unvan" class="form-select">
                    <option value="Dr.">Dr.</option>
                    <option value="Uzm. Dr.">Uzm. Dr.</option>
                    <option value="Doç. Dr.">Doç. Dr.</option>
                    <option value="Prof. Dr.">Prof. Dr.</option>
                </select>

                <span asp-validation-for="Unvan"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ad" class="form-label">
                    Ad
                </label>

                <input asp-for="Ad" class="form-control" />

                <span asp-validation-for="Ad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Soyad" class="form-label">
                    Soyad
                </label>

                <input asp-for="Soyad" class="form-control" />

                <span asp-validation-for="Soyad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PoliklinikId" class="form-label">
                    Poliklinik
                </label>

                <select asp-for="PoliklinikId"
                        asp-items="ViewBag.Poliklinikler"
                        class="form-select">
                    <option value="">Poliklinik seçin</option>
                </select>

                <span asp-validation-for="PoliklinikId"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Giriş E-postası</label>

                @if (!string.IsNullOrWhiteSpace(Model.HesapEpostasi))
                {
                    <input value="@Model.HesapEpostasi"
                           class="form-control"
                           readonly />
                }
                else
                {
                    <input value="Bu doktor için giriş hesabı bulunmuyor."
                           class="form-control"
                           readonly />
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Değişiklikleri Kaydet
                </button>

                <a asp-controller="Admin"
                   asp-action="Doktorlar"
                   class="btn btn-outline-secondary">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}