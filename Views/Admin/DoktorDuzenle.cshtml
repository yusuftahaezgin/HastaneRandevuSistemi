
@model HastaneRandevuSistemi.Models.DoktorDuzenleViewModel

@{
    ViewData["Title"] = "Doktor Düzenle";
}

<div class="container py-5">

    @if (TempData["Basari"] is string basari)
    {
        <div class="alert alert-success" role="alert">
            @basari
        </div>
    }

    @if (TempData["Hata"] is string hata)
    {
        <div class="alert alert-danger" role="alert">
            @hata
        </div>
    }

    <div class="mb-4">
        <h2>Doktor Düzenle</h2>
        <p class="text-muted">
            Doktorun bilgilerini güncelleyebilirsiniz.
        </p>
    </div>

    <!-- DOKTOR BİLGİLERİ -->

    <div class="card p-4" style="max-width: 700px;">
        <form asp-controller="Admin"
              asp-action="DoktorDuzenle"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Unvan" class="form-label">
                    Unvan
                </label>

                <select asp-for="Unvan" class="form-select">
                    <option value="Dr.">Dr.</option>
                    <option value="Uzm. Dr.">Uzm. Dr.</option>
                    <option value="Doç. Dr.">Doç. Dr.</option>
                    <option value="Prof. Dr.">Prof. Dr.</option>
                </select>

                <span asp-validation-for="Unvan"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ad" class="form-label">
                    Ad
                </label>

                <input asp-for="Ad" class="form-control" />

                <span asp-validation-for="Ad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Soyad" class="form-label">
                    Soyad
                </label>

                <input asp-for="Soyad" class="form-control" />

                <span asp-validation-for="Soyad"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PoliklinikId" class="form-label">
                    Poliklinik
                </label>

                <select asp-for="PoliklinikId"
                        asp-items="ViewBag.Poliklinikler"
                        class="form-select">
                    <option value="">
                        Poliklinik seçin
                    </option>
                </select>

                <span asp-validation-for="PoliklinikId"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Giriş E-postası
                </label>

                @if (!string.IsNullOrWhiteSpace(Model.HesapEpostasi))
                {
                    <input value="@Model.HesapEpostasi"
                           class="form-control"
                           readonly />
                }
                else
                {
                    <input value="Bu doktor için giriş hesabı bulunmuyor."
                           class="form-control"
                           readonly />
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary">
                    Değişiklikleri Kaydet
                </button>

                <a asp-controller="Admin"
                   asp-action="Doktorlar"
                   class="btn btn-outline-secondary">
                    İptal
                </a>
            </div>
        </form>
    </div>

    <!-- DOKTOR PAROLA YENİLEME -->

    <div class="card p-4 mt-4" style="max-width: 700px;">

        <h4 class="h5 mb-2">
            Doktor Parolasını Yenile
        </h4>

        <p class="text-muted">
            Doktorun eski parolasını bilmeden
            yeni bir parola belirleyebilirsiniz.
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.HesapEpostasi))
        {
            <form asp-controller="Admin"
                  asp-action="DoktorParolaSifirla"
                  method="post"
                  autocomplete="off">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="doktorId"
                       value="@Model.Id" />

                <div class="mb-3">
                    <label for="yeniParola"
                           class="form-label">
                        Yeni Parola
                    </label>

                    <input id="yeniParola"
                           name="yeniParola"
                           type="password"
                           class="form-control"
                           minlength="8"
                           autocomplete="new-password"
                           required />
                </div>

                <div class="mb-3">
                    <label for="yeniParolaTekrar"
                           class="form-label">
                        Yeni Parola (Tekrar)
                    </label>

                    <input id="yeniParolaTekrar"
                           name="yeniParolaTekrar"
                           type="password"
                           class="form-control"
                           minlength="8"
                           autocomplete="new-password"
                           required />
                </div>

                <p class="text-muted small">
                    Parola en az 8 karakter olmalı;
                    büyük harf, küçük harf, rakam
                    ve özel karakter içermelidir.
                </p>

                <button type="submit"
                        class="btn btn-warning">
                    Parolayı Yenile
                </button>
            </form>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                Bu doktora bağlı bir giriş hesabı
                olmadığından parola yenilenemez.
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
