@model IEnumerable<HastaneRandevuSistemi.Models.Doktor>

@{
    ViewData["Title"] = "Doktor Yönetimi";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Doktor Yönetimi</h2>
            <p class="text-muted mb-0">
                Hastanedeki doktorları buradan yönetebilirsiniz.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Yönetici Paneline Dön
            </a>

            <a asp-controller="Admin"
               asp-action="DoktorEkle"
               class="btn btn-primary">
                + Yeni Doktor Ekle
            </a>
        </div>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success">
            @TempData["Basari"]
        </div>
    }

    <div class="card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Doktor</th>
                        <th>Poliklinik</th>
                        <th>Giriş E-postası</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var doktor in Model)
                    {
                        <tr>
                            <td>@doktor.Id</td>

                            <td>
                                <strong>
                                    @doktor.Unvan @doktor.Ad @doktor.Soyad
                                </strong>
                            </td>

                            <td>@doktor.Poliklinik.Ad</td>

                            <td>
                                @if (doktor.Kullanici != null)
                                {
                                    @doktor.Kullanici.Email
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Giriş hesabı yok
                                    </span>
                                }
                            </td>

                            <td>
                                @if (doktor.AktifMi)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-controller="Admin"
                                       asp-action="DoktorDuzenle"
                                       asp-route-id="@doktor.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Düzenle
                                    </a>

                                    <form asp-controller="Admin"
                                          asp-action="DoktorDurumDegistir"
                                          asp-route-id="@doktor.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        @if (doktor.AktifMi)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Pasif Yap
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Aktif Yap
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>