
@{
    ViewData["Title"] = "Yönetici Paneli";
}

<div class="container py-5">
    <div class="mb-4">
        <h2>Yönetici Paneli</h2>
        <p class="text-muted">
            Hastane işlemlerini buradan yönetebilirsiniz.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card h-100 p-4">
                <h4>Poliklinik Yönetimi</h4>
                <p class="text-muted">
                    Poliklinik ekleme, düzenleme ve silme işlemleri.
                </p>
                <a asp-controller="Admin"
                   asp-action="Poliklinikler"
                   class="btn btn-primary mt-auto">
                    Poliklinikleri Yönet
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 p-4">
                <h4>Doktor Yönetimi</h4>
                <p class="text-muted">
                    Doktor ekleme, düzenleme ve silme işlemleri.
                </p>
                <a asp-controller="Admin"
                   asp-action="Doktorlar"
                   class="btn btn-primary mt-auto">
                    Doktorları Yönet
                </a>
            </div>
        </div>

    </div>
</div>
