@{
    ViewData["Title"] = "Yönetici Paneli";

    var kartlar = new[]
    {
        (
            "UcretVeHizmetler",
            "Ücret ve Hizmet Yönetimi",
            "Doktor ücretlerini, sağlık personeli hizmetlerini ve personel çalışma saatlerini yönetin."
        ),
        (
            "Randevular",
            "Randevu Onayları",
            "Hasta taleplerini inceleyin, onaylayın, reddedin veya iptal edin."
        ),
        (
            "CalismaSaatleri",
            "Doktor Çalışma Saatleri",
            "Doktorların haftalık çalışma günlerini, saatlerini ve randevu sürelerini yönetin."
        ),
        (
            "Kurumlar",
            "Kurum Yönetimi",
            "Kurum kategorilerini ve aktiflik durumlarını yönetin."
        ),
        (
            "Subeler",
            "Şube Yönetimi",
            "Hastanelerin adreslerini ve iletişim bilgilerini yönetin."
        ),
        (
            "Poliklinikler",
            "Poliklinik Yönetimi",
            "Poliklinikleri ve aktiflik durumlarını yönetin."
        ),
        (
            "Doktorlar",
            "Doktor Yönetimi",
            "Doktorları, polikliniklerini ve giriş hesaplarını yönetin."
        ),
        (
            "SaglikPersonelleri",
            "Sağlık Personeli Yönetimi",
            "Personelleri, görevlerini ve giriş hesaplarını yönetin."
        )
    };
}

<div class="container py-5">
    <div class="mb-4">
        <h2>Yönetici Paneli</h2>
        <p class="text-muted">
            Hastane işlemlerini buradan yönetebilirsiniz.
        </p>
    </div>

    <div class="row g-4">
        @foreach (var kart in kartlar)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 p-4">
                    <h4 class="mb-3">@kart.Item2</h4>

                    <p class="text-muted">@kart.Item3</p>

                    <a asp-controller="Admin"
                       asp-action="@kart.Item1"
                       class="btn btn-primary mt-auto">
                        Yönet
                    </a>
                </div>
            </div>
        }
    </div>
</div>