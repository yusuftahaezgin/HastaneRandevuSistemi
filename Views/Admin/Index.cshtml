@{
    ViewData["Title"] = "Yönetici Paneli";
}

<div class="container py-5">
    <div class="mb-4">
        <h2>Yönetici Paneli</h2>
        <p class="text-muted">
            Hastane işlemlerini buradan yönetebilirsiniz.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 p-4">
                <h4 class="mb-3">Poliklinik Yönetimi</h4>

                <p class="text-muted">
                    Poliklinik ekleyin, bilgilerini ve aktiflik durumunu düzenleyin.
                </p>

                <a asp-controller="Admin"
                   asp-action="Poliklinikler"
                   class="btn btn-primary mt-auto">
                    Poliklinikleri Yönet
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 p-4">
                <h4 class="mb-3">Doktor Yönetimi</h4>

                <p class="text-muted">
                    Doktorları, polikliniklerini ve giriş hesaplarını yönetin.
                </p>

                <a asp-controller="Admin"
                   asp-action="Doktorlar"
                   class="btn btn-primary mt-auto">
                    Doktorları Yönet
                </a>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 p-4">
                <h4 class="mb-3">Sağlık Personeli Yönetimi</h4>

                <p class="text-muted">
                    Sağlık personelini, görevlerini ve polikliniklerini yönetin.
                </p>

                <a asp-controller="Admin"
                   asp-action="SaglikPersonelleri"
                   class="btn btn-primary mt-auto">
                    Sağlık Personelini Yönet
                </a>
            </div>
        </div>
    </div>
</div>