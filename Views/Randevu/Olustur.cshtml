@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Globalization
@model HastaneRandevuSistemi.Models.RandevuSecimViewModel

@{
    ViewData["Title"] = "Randevu Al";

    var kultur = CultureInfo.GetCultureInfo("tr-TR");

    var seciliKurum = Model.Kurumlar
        .FirstOrDefault(k => k.Id == Model.SeciliKurumId);

    var seciliSube = Model.Subeler
        .FirstOrDefault(s => s.Id == Model.SeciliSubeId);

    var seciliPoliklinik = Model.Poliklinikler
        .FirstOrDefault(p => p.Id == Model.SeciliPoliklinikId);
}

<section class="booking-page">
    <div class="booking-header">
        <span class="page-label">RANDEVU İŞLEMLERİ</span>
        <h1>Randevu Al</h1>

        <p>
            Kurum, hastane, poliklinik ve doktor seçerek çalışma saatlerini inceleyin.
        </p>
    </div>

    <div asp-validation-summary="All"
         class="text-danger mb-3"
         role="alert">
    </div>

    <div class="booking-panel">
        @if (Model.Kurumlar.Count == 0)
        {
            <div class="alert alert-info mb-0">
                Şu anda seçim yapabileceğiniz aktif bir kurum bulunmuyor.
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-4">
                    <form asp-controller="Randevu"
                          asp-action="Olustur"
                          method="get">

                        <label for="kurumId" class="form-label">
                            1. Kurum
                        </label>

                        <select id="kurumId"
                                name="kurumId"
                                class="form-select"
                                asp-items="@(new SelectList(
                                    Model.Kurumlar,
                                    "Id",
                                    "Ad",
                                    Model.SeciliKurumId))">

                            <option value="">Kurum seçin</option>
                        </select>

                        <button type="submit"
                                class="btn btn-primary mt-3">
                            Hastaneleri Göster
                        </button>
                    </form>
                </div>

                @if (Model.SeciliKurumId.HasValue)
                {
                    <div class="col-lg-4">
                        @if (Model.Subeler.Count == 0)
                        {
                            <div class="alert alert-info mb-0">
                                Bu kuruma bağlı aktif hastane bulunmuyor.
                            </div>
                        }
                        else
                        {
                            <form asp-controller="Randevu"
                                  asp-action="Olustur"
                                  method="get">

                                <input type="hidden"
                                       name="kurumId"
                                       value="@Model.SeciliKurumId" />

                                <label for="subeId" class="form-label">
                                    2. Hastane
                                </label>

                                <select id="subeId"
                                        name="subeId"
                                        class="form-select"
                                        asp-items="@(new SelectList(
                                            Model.Subeler,
                                            "Id",
                                            "Ad",
                                            Model.SeciliSubeId))">

                                    <option value="">Hastane seçin</option>
                                </select>

                                <button type="submit"
                                        class="btn btn-primary mt-3">
                                    Poliklinikleri Göster
                                </button>
                            </form>
                        }
                    </div>
                }

                @if (Model.SeciliSubeId.HasValue)
                {
                    <div class="col-lg-4">
                        @if (Model.Poliklinikler.Count == 0)
                        {
                            <div class="alert alert-info mb-0">
                                Bu hastaneye bağlı aktif poliklinik bulunmuyor.
                            </div>
                        }
                        else
                        {
                            <form asp-controller="Randevu"
                                  asp-action="Olustur"
                                  method="get">

                                <input type="hidden"
                                       name="kurumId"
                                       value="@Model.SeciliKurumId" />

                                <input type="hidden"
                                       name="subeId"
                                       value="@Model.SeciliSubeId" />

                                <label for="poliklinikId" class="form-label">
                                    3. Poliklinik
                                </label>

                                <select id="poliklinikId"
                                        name="poliklinikId"
                                        class="form-select"
                                        asp-items="@(new SelectList(
                                            Model.Poliklinikler,
                                            "Id",
                                            "Ad",
                                            Model.SeciliPoliklinikId))">

                                    <option value="">Poliklinik seçin</option>
                                </select>

                                <button type="submit"
                                        class="btn btn-primary mt-3">
                                    Doktorları Göster
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (Model.SeciliPoliklinikId.HasValue)
    {
        <div class="booking-doctors">
            <h2>Doktorlar</h2>

            <p class="text-muted">
                @seciliKurum?.Ad /
                @seciliSube?.Ad /
                @seciliPoliklinik?.Ad
            </p>

            @if (Model.Doktorlar.Count == 0)
            {
                <div class="alert alert-info">
                    Bu poliklinikte şu anda aktif doktor bulunmuyor.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var doktor in Model.Doktorlar)
                    {
                        var seciliMi = Model.SeciliDoktorId == doktor.Id;

                        <div class="col-md-6 col-xl-4">
                            <div class="doctor-card">
                                <div class="doctor-card-top">
                                    <span class="doctor-label">DOKTOR</span>

                                    @if (seciliMi)
                                    {
                                        <span class="badge bg-success">
                                            Seçildi
                                        </span>
                                    }
                                </div>

                                <h3>@doktor.GorunenAdGetir()</h3>

                                <p class="doctor-specialty">
                                    @doktor.Poliklinik.Ad
                                </p>

                                <p class="text-muted">
                                    @seciliSube?.Ad
                                </p>

                                <a asp-controller="Randevu"
                                   asp-action="Olustur"
                                   asp-route-kurumId="@Model.SeciliKurumId"
                                   asp-route-subeId="@Model.SeciliSubeId"
                                   asp-route-poliklinikId="@Model.SeciliPoliklinikId"
                                   asp-route-doktorId="@doktor.Id"
                                   class="doctor-select-link">
                                    @(seciliMi ? "Seçilen Doktor" : "Doktoru Seç →")
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (Model.SeciliDoktor is not null)
    {
        <div class="booking-panel selected-doctor">
            <span class="page-label">SEÇİMİNİZ</span>

            <h2>@Model.SeciliDoktor.GorunenAdGetir()</h2>

            <dl class="row mb-0">
                <dt class="col-sm-3">Kurum</dt>
                <dd class="col-sm-9">@seciliKurum?.Ad</dd>

                <dt class="col-sm-3">Hastane</dt>
                <dd class="col-sm-9">@seciliSube?.Ad</dd>

                <dt class="col-sm-3">Poliklinik</dt>
                <dd class="col-sm-9">@seciliPoliklinik?.Ad</dd>
            </dl>

            <hr class="my-4" />

            <form asp-controller="Randevu"
                  asp-action="Olustur"
                  method="get"
                  novalidate>

                <input type="hidden"
                       name="kurumId"
                       value="@Model.SeciliKurumId" />

                <input type="hidden"
                       name="subeId"
                       value="@Model.SeciliSubeId" />

                <input type="hidden"
                       name="poliklinikId"
                       value="@Model.SeciliPoliklinikId" />

                <input type="hidden"
                       name="doktorId"
                       value="@Model.SeciliDoktorId" />

                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="tarih" class="form-label">
                            Randevu Tarihi
                        </label>

                        <input id="tarih"
                               name="tarih"
                               type="date"
                               class="form-control"
                               value="@(Model.SeciliTarih?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"
                               min="@Model.Bugun.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                               max="@Model.SonSecilebilirTarih.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                               aria-describedby="tarihAciklama" />
                    </div>

                    <div class="col-md-6">
                        <button type="submit"
                                class="btn btn-primary">
                            Saatleri Göster
                        </button>
                    </div>
                </div>

                <p id="tarihAciklama"
                   class="text-muted small mt-2">
                    Bugün ile
                    @Model.SonSecilebilirTarih.ToString("dd.MM.yyyy")
                    arasında seçim yapabilirsiniz.
                    Saatler Türkiye saatine göredir.
                </p>
            </form>

            @if (Model.SeciliTarih.HasValue)
            {
                <h3 class="h5 mt-4">
                    @Model.SeciliTarih.Value.ToString(
                        "dd MMMM yyyy dddd",
                        kultur)
                </h3>

                @if (!Model.SeciliGundeCalismaVar)
                {
                    <div class="alert alert-info mt-3">
                        Doktorun seçilen gün için aktif çalışma programı
                        bulunmuyor. Başka bir tarih seçebilirsiniz.
                    </div>
                }
                else if (Model.Saatler.Count == 0)
                {
                    <div class="alert alert-info mt-3">
                        Seçilen gün için ileri bir randevu saati kalmadı.
                        Başka bir tarih seçebilirsiniz.
                    </div>
                }
                else
                {
                    <p class="text-muted">
                        Çalışma programına göre
                        @Model.Saatler.Count saat aralığı listeleniyor.
                    </p>

                    <div class="row g-2">
                        @foreach (var saat in Model.Saatler)
                        {
                            <div class="col-6 col-md-4 col-xl-3">
                                <div class="border rounded p-3 bg-white text-center h-100">
                                    <strong class="text-nowrap">
                                        @saat.BaslangicSaati.ToString("HH:mm")
                                        –
                                        @saat.BitisSaati.ToString("HH:mm")
                                    </strong>

                                    <div class="small text-muted">
                                        @saat.RandevuSuresiDakika dakika
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            <p class="text-muted mt-3 mb-0">
                Henüz randevu oluşturulmadı.
            </p>
        </div>
    }
</section>