@model HastaneRandevuSistemi.Models.RandevuSecimViewModel
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Randevu Al";
    var tr = CultureInfo.GetCultureInfo("tr-TR");

    var kurum = Model.Kurumlar
        .FirstOrDefault(x => x.Id == Model.SeciliKurumId);

    var sube = Model.Subeler
        .FirstOrDefault(x => x.Id == Model.SeciliSubeId);

    var poliklinik = Model.Poliklinikler
        .FirstOrDefault(x => x.Id == Model.SeciliPoliklinikId);
}

<section class="booking-page">
    <div class="booking-header">
        <span class="page-label">RANDEVU İŞLEMLERİ</span>
        <h1>Randevu Al</h1>
        <p>Kurum, hastane, poliklinik ve doktor seçin.</p>

        <a asp-controller="Randevu"
           asp-action="Hizmet"
           class="btn btn-outline-primary">
            Sağlık Personeli Hizmetleri
        </a>

        <a asp-controller="Randevu"
           asp-action="Liste"
           class="btn btn-outline-secondary">
            Randevularım
        </a>
    </div>

    @if (TempData["Hata"] is string hata)
    {
        <div class="alert alert-danger">@hata</div>
    }

    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <div class="booking-panel">
        @if (Model.Kurumlar.Count == 0)
        {
            <div class="alert alert-info">
                Aktif kurum bulunmuyor.
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-4">
                    <form asp-controller="Randevu"
                          asp-action="Olustur"
                          method="get">

                        <label for="kurumId" class="form-label">
                            1. Kurum
                        </label>

                        <select id="kurumId"
                                name="kurumId"
                                class="form-select"
                                asp-items="@(new SelectList(
                                    Model.Kurumlar,
                                    "Id",
                                    "Ad",
                                    Model.SeciliKurumId))">
                            <option value="">Kurum seçin</option>
                        </select>

                        <button class="btn btn-primary mt-3">
                            Hastaneleri Göster
                        </button>
                    </form>
                </div>

                @if (Model.SeciliKurumId.HasValue)
                {
                    <div class="col-lg-4">
                        @if (Model.Subeler.Count == 0)
                        {
                            <div class="alert alert-info">
                                Bu kuruma bağlı aktif hastane bulunmuyor.
                            </div>
                        }
                        else
                        {
                            <form asp-controller="Randevu"
                                  asp-action="Olustur"
                                  method="get">

                                <input type="hidden"
                                       name="kurumId"
                                       value="@Model.SeciliKurumId" />

                                <label for="subeId" class="form-label">
                                    2. Hastane
                                </label>

                                <select id="subeId"
                                        name="subeId"
                                        class="form-select"
                                        asp-items="@(new SelectList(
                                            Model.Subeler,
                                            "Id",
                                            "Ad",
                                            Model.SeciliSubeId))">
                                    <option value="">Hastane seçin</option>
                                </select>

                                <button class="btn btn-primary mt-3">
                                    Poliklinikleri Göster
                                </button>
                            </form>
                        }
                    </div>
                }

                @if (Model.SeciliSubeId.HasValue)
                {
                    <div class="col-lg-4">
                        @if (Model.Poliklinikler.Count == 0)
                        {
                            <div class="alert alert-info">
                                Bu hastaneye bağlı aktif poliklinik bulunmuyor.
                            </div>
                        }
                        else
                        {
                            <form asp-controller="Randevu"
                                  asp-action="Olustur"
                                  method="get">

                                <input type="hidden"
                                       name="kurumId"
                                       value="@Model.SeciliKurumId" />

                                <input type="hidden"
                                       name="subeId"
                                       value="@Model.SeciliSubeId" />

                                <label for="poliklinikId" class="form-label">
                                    3. Poliklinik
                                </label>

                                <select id="poliklinikId"
                                        name="poliklinikId"
                                        class="form-select"
                                        asp-items="@(new SelectList(
                                            Model.Poliklinikler,
                                            "Id",
                                            "Ad",
                                            Model.SeciliPoliklinikId))">
                                    <option value="">Poliklinik seçin</option>
                                </select>

                                <button class="btn btn-primary mt-3">
                                    Doktorları Göster
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (Model.SeciliPoliklinikId.HasValue)
    {
        <div class="booking-doctors">
            <h2>Doktorlar</h2>

            <p class="text-muted">
                @kurum?.Ad / @sube?.Ad / @poliklinik?.Ad
            </p>

            @if (Model.Doktorlar.Count == 0)
            {
                <div class="alert alert-info">
                    Bu poliklinikte aktif doktor bulunmuyor.
                </div>
            }

            <div class="row g-3">
                @foreach (var d in Model.Doktorlar)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="doctor-card">
                            <div class="doctor-card-top">
                                <span class="doctor-label">DOKTOR</span>

                                @if (Model.SeciliDoktorId == d.Id)
                                {
                                    <span class="badge bg-success">
                                        Seçildi
                                    </span>
                                }
                            </div>

                            <h3>@d.GorunenAdGetir()</h3>

                            <p class="doctor-specialty">
                                @d.Poliklinik.Ad
                            </p>

                            <p>@sube?.Ad</p>

                            <p>
                                <strong>Hizmet:</strong>
                                @d.HizmetAdi
                            </p>

                            <p>
                                <strong>
                                    @(d.RandevuUcreti.HasValue
                                        ? d.RandevuUcreti.Value.ToString("N2", tr) + " TL"
                                        : "Ücret henüz tanımlanmadı")
                                </strong>
                            </p>

                            <a asp-controller="Randevu"
                               asp-action="Olustur"
                               asp-route-kurumId="@Model.SeciliKurumId"
                               asp-route-subeId="@Model.SeciliSubeId"
                               asp-route-poliklinikId="@Model.SeciliPoliklinikId"
                               asp-route-doktorId="@d.Id"
                               class="doctor-select-link">
                                Doktoru Seç →
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.SeciliDoktor is { } doktor)
    {
        <div class="booking-panel selected-doctor">
            <span class="page-label">SEÇİMİNİZ</span>

            <h2>@doktor.GorunenAdGetir()</h2>

            <p>@kurum?.Ad / @sube?.Ad / @poliklinik?.Ad</p>

            <p>
                <strong>Seçilen hizmet:</strong>
                @doktor.HizmetAdi
            </p>

            <form asp-controller="Randevu"
                  asp-action="Olustur"
                  method="get"
                  novalidate>

                <input type="hidden"
                       name="kurumId"
                       value="@Model.SeciliKurumId" />

                <input type="hidden"
                       name="subeId"
                       value="@Model.SeciliSubeId" />

                <input type="hidden"
                       name="poliklinikId"
                       value="@Model.SeciliPoliklinikId" />

                <input type="hidden"
                       name="doktorId"
                       value="@doktor.Id" />

                <label for="tarih" class="form-label">
                    Randevu Tarihi
                </label>

                <div class="d-flex gap-2">
                    <input id="tarih"
                           name="tarih"
                           type="date"
                           class="form-control"
                           value="@(Model.SeciliTarih?.ToString("yyyy-MM-dd"))"
                           min="@Model.Bugun.ToString("yyyy-MM-dd")"
                           max="@Model.SonSecilebilirTarih.ToString("yyyy-MM-dd")" />

                    <button class="btn btn-primary text-nowrap">
                        Saatleri Göster
                    </button>
                </div>

                <p class="form-text">
                    Saatler Türkiye saatine göredir.
                    En fazla 30 gün sonrası seçilebilir.
                </p>
            </form>

            @if (!doktor.RandevuUcreti.HasValue)
            {
                <div class="alert alert-info">
                    Yönetici bu doktor için ücret tanımladığında
                    randevu talebi oluşturabilirsiniz.
                </div>
            }
            else if (Model.SeciliTarih.HasValue)
            {
                <h3 class="h5">
                    @Model.SeciliTarih.Value.ToString(
                        "dd MMMM yyyy dddd", tr)
                </h3>

                <p>
                    <strong>
                        Hizmet ücreti:
                        @doktor.RandevuUcreti.Value.ToString("N2", tr) TL
                    </strong>
                    Randevu talebi yönetici onayına gönderilir.
                </p>

                @if (!Model.SeciliGundeCalismaVar)
                {
                    <div class="alert alert-info">
                        Doktorun seçilen gün için aktif çalışma
                        programı bulunmuyor.
                    </div>
                }
                else if (Model.Saatler.Count == 0)
                {
                    <div class="alert alert-info">
                        Hastane ve doktor çalışma saatleri ile mevcut
                        randevular dikkate alındığında uygun saat bulunmuyor.
                        Başka tarih seçebilirsiniz.
                    </div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var s in Model.Saatler)
                        {
                            <div class="col-sm-6 col-xl-3">
                                <form asp-controller="Randevu"
                                      asp-action="DoktorKaydet"
                                      method="post"
                                      class="border rounded p-3 bg-white text-center h-100">

                                    <input type="hidden"
                                           name="doktorId"
                                           value="@doktor.Id" />

                                    <input type="hidden"
                                           name="poliklinikId"
                                           value="@Model.SeciliPoliklinikId" />

                                    <input type="hidden"
                                           name="tarih"
                                           value="@Model.SeciliTarih.Value.ToString("yyyy-MM-dd")" />

                                    <input type="hidden"
                                           name="saat"
                                           value="@s.BaslangicSaati.ToString("HH:mm")" />

                                    <input type="hidden"
                                           name="ucret"
                                           value="@doktor.RandevuUcreti.Value.ToString(CultureInfo.InvariantCulture)" />

                                    <input type="hidden"
                                           name="sure"
                                           value="@s.RandevuSuresiDakika" />

                                    <strong>
                                        @s.BaslangicSaati.ToString("HH:mm")
                                        –
                                        @s.BitisSaati.ToString("HH:mm")
                                    </strong>

                                    <div>@s.RandevuSuresiDakika dakika</div>

                                    <div>
                                        @doktor.RandevuUcreti.Value.ToString("N2", tr) TL
                                    </div>

                                    <button type="submit"
                                            class="btn btn-primary btn-sm mt-2">
                                        Randevu Talebi Oluştur
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
</section>